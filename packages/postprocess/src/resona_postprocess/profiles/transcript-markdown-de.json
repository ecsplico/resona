{
  "name": "transcript-markdown-de",
  "description": "Deutsche Diktatbefehle → Markdown (Kapitel → ##-Überschrift, Absatz, Anstrich, Satzzeichen), ohne LLM.",
  "initial_prompt": [],
  "steps": [
    {
      "type": "replacements",
      "name": "dictation-markdown",
      "rules": [
        {
          "pattern": "(?<![ \\t])[ \\t]*(?<!\\bim )(?<!\\bin )(?<!\\bins )(?<!\\bam )(?<!\\ban )(?<!\\bans )(?<!\\bdem )(?<!\\bden )(?<!\\bdas )(?<!\\bdes )(?<!\\bder )(?<!\\bdie )(?<!\\bein )(?<!\\beine )(?<!\\beinem )(?<!\\beinen )(?<!\\beines )(?<!\\bvom )(?<!\\bzum )(?<!\\bzur )(?<!\\bbeim )(?<!\\bdiesem )(?<!\\bdieses )(?<!\\bjedem )(?<!\\bwelchem )(?<!\\bletzten )(?<!\\bnächsten )(?<!\\bvorigen )(?<!\\bvorherigen )(?<!\\bfolgenden )(?<!\\bersten )(?<!\\bzweiten )(?<!\\bdritten )(?<!\\bselben )(?<!\\bgleichen )(?<!\\bneuen )(?<!\\bganzen )\\bKapitel[ \\t]+Verlauf\\b[ \\t.,:]*(?:\\b(?:Absatz|Punkt|Doppel[ \\t.,-]*punkt|Komma)\\b[.,:]?)?[ \\t]*",
          "replacement": "\n\n## Verlauf\n\n"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*(?<!\\bim )(?<!\\bin )(?<!\\bins )(?<!\\bam )(?<!\\ban )(?<!\\bans )(?<!\\bdem )(?<!\\bden )(?<!\\bdas )(?<!\\bdes )(?<!\\bder )(?<!\\bdie )(?<!\\bein )(?<!\\beine )(?<!\\beinem )(?<!\\beinen )(?<!\\beines )(?<!\\bvom )(?<!\\bzum )(?<!\\bzur )(?<!\\bbeim )(?<!\\bdiesem )(?<!\\bdieses )(?<!\\bjedem )(?<!\\bwelchem )(?<!\\bletzten )(?<!\\bnächsten )(?<!\\bvorigen )(?<!\\bvorherigen )(?<!\\bfolgenden )(?<!\\bersten )(?<!\\bzweiten )(?<!\\bdritten )(?<!\\bselben )(?<!\\bgleichen )(?<!\\bneuen )(?<!\\bganzen )\\bKapitel[ \\t]+Medikation\\b[ \\t.,:]*(?:\\b(?:Absatz|Punkt|Doppel[ \\t.,-]*punkt|Komma)\\b[.,:]?)?[ \\t]*",
          "replacement": "\n\n## Medikation\n\n"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*(?<!\\bim )(?<!\\bin )(?<!\\bins )(?<!\\bam )(?<!\\ban )(?<!\\bans )(?<!\\bdem )(?<!\\bden )(?<!\\bdas )(?<!\\bdes )(?<!\\bder )(?<!\\bdie )(?<!\\bein )(?<!\\beine )(?<!\\beinem )(?<!\\beinen )(?<!\\beines )(?<!\\bvom )(?<!\\bzum )(?<!\\bzur )(?<!\\bbeim )(?<!\\bdiesem )(?<!\\bdieses )(?<!\\bjedem )(?<!\\bwelchem )(?<!\\bletzten )(?<!\\bnächsten )(?<!\\bvorigen )(?<!\\bvorherigen )(?<!\\bfolgenden )(?<!\\bersten )(?<!\\bzweiten )(?<!\\bdritten )(?<!\\bselben )(?<!\\bgleichen )(?<!\\bneuen )(?<!\\bganzen )\\bKapitel[ \\t]+Psychopathologischer[ \\t]*Befund\\b[ \\t.,:]*(?:\\b(?:Absatz|Punkt|Doppel[ \\t.,-]*punkt|Komma)\\b[.,:]?)?[ \\t]*",
          "replacement": "\n\n## Psychopathologischer Befund\n\n"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*(?<!\\bim )(?<!\\bin )(?<!\\bins )(?<!\\bam )(?<!\\ban )(?<!\\bans )(?<!\\bdem )(?<!\\bden )(?<!\\bdas )(?<!\\bdes )(?<!\\bder )(?<!\\bdie )(?<!\\bein )(?<!\\beine )(?<!\\beinem )(?<!\\beinen )(?<!\\beines )(?<!\\bvom )(?<!\\bzum )(?<!\\bzur )(?<!\\bbeim )(?<!\\bdiesem )(?<!\\bdieses )(?<!\\bjedem )(?<!\\bwelchem )(?<!\\bletzten )(?<!\\bnächsten )(?<!\\bvorigen )(?<!\\bvorherigen )(?<!\\bfolgenden )(?<!\\bersten )(?<!\\bzweiten )(?<!\\bdritten )(?<!\\bselben )(?<!\\bgleichen )(?<!\\bneuen )(?<!\\bganzen )\\bKapitel[ \\t]+Pro[cz]edere\\b[ \\t.,:]*(?:\\b(?:Absatz|Punkt|Doppel[ \\t.,-]*punkt|Komma)\\b[.,:]?)?[ \\t]*",
          "replacement": "\n\n## Procedere\n\n"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*(?<!\\bim )(?<!\\bin )(?<!\\bins )(?<!\\bam )(?<!\\ban )(?<!\\bans )(?<!\\bdem )(?<!\\bden )(?<!\\bdas )(?<!\\bdes )(?<!\\bder )(?<!\\bdie )(?<!\\bein )(?<!\\beine )(?<!\\beinem )(?<!\\beinen )(?<!\\beines )(?<!\\bvom )(?<!\\bzum )(?<!\\bzur )(?<!\\bbeim )(?<!\\bdiesem )(?<!\\bdieses )(?<!\\bjedem )(?<!\\bwelchem )(?<!\\bletzten )(?<!\\bnächsten )(?<!\\bvorigen )(?<!\\bvorherigen )(?<!\\bfolgenden )(?<!\\bersten )(?<!\\bzweiten )(?<!\\bdritten )(?<!\\bselben )(?<!\\bgleichen )(?<!\\bneuen )(?<!\\bganzen )\\bKapitel[ \\t]+((?!(?:Komma|Punkt|Absatz|Doppel[ \\t.,-]*punkt|Fragezeichen|Ausrufezeichen|Kapitel|Anstrich|Klammer|Eckige|Hashtag)\\b)(?:[^\\s.,;:!?()\\[\\]]|(?<=\\d)[.,](?=\\d))+(?:[ \\t]+(?!(?:Komma|Punkt|Absatz|Doppel[ \\t.,-]*punkt|Fragezeichen|Ausrufezeichen|Kapitel|Anstrich|Klammer|Eckige|Hashtag)\\b)(?:[^\\s.,;:!?()\\[\\]]|(?<=\\d)[.,](?=\\d))+){0,4}?)[ \\t]*,?[ \\t]*(?:\\b(?:Absatz|Punkt|Doppel[ \\t.,-]*punkt|Fragezeichen|Ausrufezeichen)\\b[.,:!?]?|(?:(?<!\\d)\\.|[!?:])(?!\\d))[ \\t]*",
          "replacement": "\n\n## \\1\n\n"
        },
        {
          "pattern": "(?<![ \\t.])[ \\t.]*\\bEckige[ \\t.,]*Klammer[ \\t.,]*auf\\b[ \\t.,]*",
          "replacement": " ["
        },
        {
          "pattern": "(?<![ \\t.])[ \\t.]*\\bEckige[ \\t.,]*Klammer[ \\t.,]*zu\\b[ \\t.,]*",
          "replacement": "] "
        },
        {
          "pattern": "(?<![ \\t.])[ \\t.]*\\bKlammer[ \\t.,]*auf\\b[ \\t.,]*",
          "replacement": " ("
        },
        {
          "pattern": "(?<![ \\t.])[ \\t.]*\\bKlammer[ \\t.,]*zu\\b[ \\t.,]*",
          "replacement": ") "
        },
        {
          "pattern": "(?<![ \\t])(?:[ \\t]*[.,:])?[ \\t]*\\bDoppel[ \\t.,-]*punkt\\b[.,:]?",
          "replacement": ":"
        },
        {
          "pattern": "(?<![ \\t])(?:[ \\t]*[,])?[ \\t]*\\bKomma\\b[,.]?",
          "replacement": ","
        },
        {
          "pattern": "(?<![ \\t])(?:[ \\t]*[.,])?[ \\t]*\\bPunkt\\b[.,]?",
          "replacement": "."
        },
        {
          "pattern": "(?<![ \\t])(?:[ \\t]*[.,!])?[ \\t]*\\bAusrufezeichen\\b[.,!]?",
          "replacement": "!"
        },
        {
          "pattern": "(?<![ \\t])(?:[ \\t]*[.,?])?[ \\t]*\\bFragezeichen\\b[.,?]?",
          "replacement": "?"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*\\bHashtag\\b[ \\t]*",
          "replacement": " #"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]*\\bAnstrich\\b[ \\t.,:]*",
          "replacement": "\n- "
        },
        {
          "pattern": "(?<!\\s)\\s*\\bAbsatz\\b[.,]?\\s*",
          "replacement": "\n\n"
        },
        {
          "pattern": "(?<![ \\t])[ \\t]+\\n",
          "replacement": "\n"
        },
        {
          "pattern": "\\n{3,}",
          "replacement": "\n\n"
        },
        {
          "pattern": "\\A\\s+|(?<!\\s)\\s+\\Z",
          "replacement": ""
        }
      ]
    }
  ]
}
