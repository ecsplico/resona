{
  "name": "@ecsplico/resona-hub-client",
  "version": "0.0.0",
  "description": "TypeScript client for the Resona hub HTTP contract (contract/openapi.json)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecsplico/resona.git",
    "directory": "clients/hub-ts"
  },
  "homepage": "https://github.com/ecsplico/resona/tree/main/clients/hub-ts#readme",
  "bugs": "https://github.com/ecsplico/resona/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contract/openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9",
    "vitest": "^5.1.1"
  }
}
