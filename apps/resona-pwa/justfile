default:
    @just --list

# Install JS dependencies (runs `nuxt prepare`)
install:
    bun install

# Start the data layer (Directus + worker, no PWA container)
backend:
    docker compose -f docker-compose.backend.yml up -d

# Start the frontend dev server locally, exposed on the network
pwa:
    bun run dev -- --host

# Start the PWA docker container (assumes backend is already up)
pwa-docker:
    docker compose up -d pwa

# Start the full stack (data layer + PWA container) against an external hub; generates secrets on first run
full:
    bun run setup

# Run the frontend test suite
test:
    bun run test

# Run the project worker's tests (own uv environment in worker/)
test-worker:
    cd worker && uv run pytest -q

# Lint and type-check the frontend
check:
    bun run lint
    bun run typecheck
