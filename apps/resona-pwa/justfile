default:
    @just --list

# Start the data layer (Directus + worker, no PWA container)
backend:
    docker compose -f docker-compose.backend.yml up -d

# Start the frontend dev server locally
pwa:
    bun run dev

# Start the PWA docker container (assumes backend is already up)
pwa-docker:
    docker compose up -d pwa

# Start the full stack (data layer + resona + PWA container); generates secrets on first run
full:
    bun run setup

# Run the test suite
test:
    bun run test
