<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Capacitor Preferences (CapacitorStorage.xml) holds the Directus
     refresh token (JSON auth): no cloud backup and no device transfer of it, a
     restored or transferred app signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
