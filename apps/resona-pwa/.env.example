NUXT_PUBLIC_DIRECTUS_URL=http://localhost:7700
NUXT_PUBLIC_RESONA_API_URL=http://localhost:7710
NUXT_PUBLIC_DEFAULT_LANGUAGE=de
NUXT_PUBLIC_DEFAULT_PROFILE=default
# directus | standalone
NUXT_PUBLIC_DATA_MODE=directus

# Google Calendar integration (server-only OAuth secrets — never exposed to the
# browser). Create an OAuth client (type "Web application") in Google Cloud and
# add <origin>/api/calendar as an authorized redirect URI (e.g.
# http://localhost:7701/api/calendar).
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI; derived from the request origin when empty.
NUXT_GOOGLE_REDIRECT_URI=
# Secret (>= 32 chars) sealing the session cookie that stores calendar tokens.
# e.g. `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=
