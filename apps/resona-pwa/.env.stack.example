# ─── resona-pwa backend stack (docker-compose.yml) ───────────────────────
# Copy to `.env` before `docker compose up`.

# ── PWA (Nuxt) ─────────────────────────────────────────────────────────────
# Published port for the PWA container (default 3000).
PWA_PORT=7730

# Public config — baked into the client JS bundle at build time, so these
# must be URLs reachable by the *browser* (not compose service names).
# For external access replace localhost with the server's hostname / IP.
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:7700
NUXT_PUBLIC_RESONA_API_URL=http://localhost:7710
NUXT_PUBLIC_DEFAULT_LANGUAGE=de
NUXT_PUBLIC_DEFAULT_PROFILE=default
NUXT_PUBLIC_CALENDAR_ENABLED=false
# directus | standalone
NUXT_PUBLIC_DATA_MODE=directus

# Google Calendar OAuth — server-only, never exposed to the browser.
# Create an OAuth client (Web application) in Google Cloud Console and add
# <origin>/api/calendar as an authorized redirect URI.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI; derived from the request origin when empty.
NUXT_GOOGLE_REDIRECT_URI=
# >= 32-char secret sealing the session cookie. `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=

# ── Directus ───────────────────────────────────────────────────────────────
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
# Browser origin allowed by Directus CORS — must match the PWA's public URL.
# Both the dev server (bun run dev) and the PWA docker container use port 7730.
PWA_ORIGIN=http://localhost:7730

# Worker static token. REQUIRED before `docker compose up` — directus-bootstrap
# pins it as the transcribe-worker's token and the worker won't start if empty.
# `bun run setup` generates + fills this automatically; or set it by hand with
# `openssl rand -hex 24`.
DIRECTUS_TOKEN=

# project-worker → Resona hub (external: resona monorepo or Coolify).
RESONA_API_URL=http://host.docker.internal:7710
# REQUIRED: hub client token, org-bound
# (`resona-admin credential issue --organization <org> --role client`).
RESONA_API_KEY=
# Audio engine requested per recording job. LEAVE EMPTY for the hub default.
WORKER_ENGINE=
WORKER_POLL_INTERVAL=5
# Max pending rows submitted per collection (recordings, documents) per cycle.
WORKER_BATCH=5
# Active rows WITHOUT a hub job older than this go back to pending.
WORKER_STALE_MINUTES=15
LOGLEVEL=info
