# ─── resona-pwa backend stack (docker-compose.yml) ───────────────────────
# Copy to `.env` before `docker compose up`. (Frontend NUXT_PUBLIC_* vars live
# in .env.example — these are the Directus + worker stack vars.)

# Directus
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
# Browser origin allowed by Directus CORS (the running PWA).
PWA_ORIGIN=http://localhost:3000

# Worker static token. REQUIRED before `docker compose up` — directus-bootstrap
# pins it as the transcribe-worker's token and the worker won't start if empty.
# `bun run setup` generates + fills this automatically; or set it by hand with
# `openssl rand -hex 24`.
DIRECTUS_TOKEN=

# directus-transcribe worker → resona-api (the separate resona stack).
RESONA_API_URL=http://host.docker.internal:7710
RESONA_API_KEY=
# Engine requested per batch job. LEAVE EMPTY in the full stack
# (docker-compose.full.yml) so the worker doesn't pin one and resona-api
# auto-selects the first available engine — native MLX (host :7720) preferred,
# dockerized CPU faster-whisper as fallback. Set a name only to force one.
TRANSCRIBE_ENGINE=
# Override resona-api's engine pool / preference order (full stack only).
# Default: native MLX first, dockerized CPU engine as fallback.
# RESONA_ENGINE_URLS=http://host.docker.internal:7720,http://engine-faster-whisper:7001
TRANSCRIBE_POLL_INTERVAL=5
TRANSCRIBE_CONCURRENCY=2
TRANSCRIBE_STALE_MINUTES=15
LOGLEVEL=info
