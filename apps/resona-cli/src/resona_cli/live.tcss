/* CSS for the resona-live TUI */

TabbedContent {
    height: 1fr;
}

#pane_header {
    dock: top;
    height: auto;
    padding: 0 1;
    background: $boost;
    align: left middle;
}

#pane_filename {
    width: 1fr;
}

#live_switch {
    margin-right: 1;
}

.switch_label {
    width: auto;
    margin-right: 2;
}

#pane_status {
    width: 2fr;
}

#doc_area {
    height: 1fr;
    border: solid $accent;
}

/* Debug Logs tab (--debug) */

#log_display {
    height: 1fr;
    border: solid $secondary;
}

/* New-file modal */

NewFileModal {
    align: center middle;
}

#new_file_dialog {
    width: 60;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#new_file_input {
    margin-top: 1;
}

#new_file_buttons {
    margin-top: 1;
    height: auto;
    align: right middle;
}

#new_file_buttons Button {
    margin-left: 1;
}
