# Frontend (baked into the client bundle at build time; see resona-pwa/.env.example)
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:7700
NUXT_PUBLIC_RESONA_API_URL=http://localhost:7710
NUXT_PUBLIC_DEFAULT_LANGUAGE=de
NUXT_PUBLIC_DEFAULT_PROFILE=default
NUXT_PUBLIC_DATA_MODE=directus
# Base of /api/termine; empty = same origin. Only the Capacitor build needs it
# (e.g. https://verlauf.example.org).
NUXT_PUBLIC_VERLAUF_API_BASE=

# Server only (read at runtime by Nitro, never sent to the browser)
# Google OAuth client (type "Web application"); authorized redirect URI:
# <origin>/api/termine (e.g. http://localhost:7731/api/termine).
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI; derived from the request origin when empty.
NUXT_GOOGLE_REDIRECT_URI=
# Secret (>= 32 chars) sealing the stored refresh token, e.g. `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=
# Directus as the server reaches it; /api/termine checks the caller's token at /users/me.
NUXT_DIRECTUS_INTERNAL_URL=http://localhost:7700
# Google calendar id to read (empty = the connected account's primary calendar)
NUXT_VERLAUF_CALENDAR_ID=
# Only events whose title starts with one of these (case-sensitive) are shown
NUXT_VERLAUF_TITLE_PREFIXES=EG,FG
# Directus user emails allowed to read the calendar (comma list; empty = any signed-in user)
NUXT_VERLAUF_ALLOWED_EMAILS=
# Directory for the sealed refresh token (mount a volume here in production)
NUXT_VERLAUF_DATA_DIR=.data/verlauf
