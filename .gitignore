# ── Secrets ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Runtime data (per-deployment; resona-api creates these on demand) ──
data/
db/
files/
md/
inbox/
# ...but never the resona-api db package (schema.py, models.py)
!packages/api/src/resona_api/db/
# ...nor the PWA's client-side data layer (app/data/*.ts)
!apps/resona-pwa/app/data/

# ── Model weights / benchmark artifacts ─────────────────────────────
# lightning-whisper-mlx downloads here when LIGHTNING_MLX_MODELS_DIR is unset
# and CWD-relative resolution kicks in; never commit multi-GB weights.
mlx_models/
# Benchmark sample audio cache (large .npy); results/ is kept as a record.
benchmarks/cache/
# Transient transcript dumps from benchmarks/_diagnose.py
benchmarks/diagnose/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
.python-version-local

# ── Docs build output (mkdocs) ──────────────────────────────────────
site/

# ── Tooling caches ──────────────────────────────────────────────────
.superpowers/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.worktrees/
# Local agent scratch (plan autosave, drafts). Tickets live on GitHub.
.scratch/

# ── Model caches (kept out of repo even if a user drops them in) ────
models/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
*.ckpt

# ── IDE / editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Legacy ──────────────────────────────────────────────────────────
# Do NOT add `src/` here — every workspace package uses a src-layout
# (packages/*/src/ and apps/resona-cli/src/), and hatchling honors
# .gitignore at build time. An `src/` rule produces empty wheels.
whisper-*
.claude/settings.local.json

# ── impeccable design-tool scratch (durable briefs live in docs/design/) ──
.impeccable/

# ── omp plan-mode autosave (session drafts; durable plans are epic issues) ──
.omp/plans/

# admin page vendor build (packages/api/admin-vendor/build.sh)
packages/api/admin-vendor/node_modules/
